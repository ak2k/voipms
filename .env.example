# VoIP.ms Credentials

# Your VoIP.ms username (same for both website and API)
VOIPMS_USERNAME='your-email@example.com'

# 1. API Password (for making API calls)
# Set this at: https://voip.ms/m/api.php
# This is NOT your website login password!
VOIPMS_API_PASSWORD='your-api-password'

# 2. Website Password (for downloading documentation) 
# This is your regular VoIP.ms login password
VOIPMS_PASSWORD='your-website-password'

# Important Notes:
# - Username is the same for both website and API
# - API password must be set separately at https://voip.ms/m/api.php
# - API password and website password are DIFFERENT
# - Both VOIPMS_USERNAME and VOIPMS_API_PASSWORD are required to use the client
# - VOIPMS_PASSWORD is only needed to download updated documentation
#
# To download documentation automatically:
# 1. Set VOIPMS_USERNAME and VOIPMS_PASSWORD above
# 2. Run: ./tools/download_api_docs.py
# 3. If Cloudflare blocks access, download manually from https://voip.ms/m/apidocs.php