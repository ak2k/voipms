{
  "version": "1.0",
  "description": "Corrections and overrides for VoIP.ms API definition",
  
  "error_codes": {
    "invalid_if_announce_position_enabled_report_estimated_hold_time": "This is not a Report estimated hold time type",
    "missing_if_announce_position_enabled_report_estimated_hold_time": "If announce position enabled report estimated hold time type was not provided"
  },
  
  "operations": {
    "getRegistrationStatus": {
      "parameters": {
        "account": {
          "type": "string",
          "_type_override_reason": "Accepts values like '100001_VoIP'"
        }
      }
    },
    
    "getBalance": {
      "parameters": {
        "account": {
          "type": "string",
          "_type_override_reason": "Accepts values like '100001_VoIP'"
        },
        "advanced": {
          "enum": ["0", "1"],
          "_enum_source": "Discovered from API usage"
        }
      }
    },
    
    "setVoicemail": {
      "parameters": {
        "say_callerid": {
          "type": "string",
          "_transform": {
            "type": "boolean_to_yes_no",
            "from": "boolean",
            "to": "string",
            "mapping": {"true": "yes", "false": "no"}
          },
          "_accepted_values": ["yes", "no"]
        },
        "attach_message": {
          "type": "string",
          "_transform": {
            "type": "boolean_to_yes_no",
            "from": "boolean",
            "to": "string",
            "mapping": {"true": "yes", "false": "no"}
          }
        },
        "delete_message": {
          "type": "string",
          "_transform": {
            "type": "boolean_to_yes_no",
            "from": "boolean",
            "to": "string",
            "mapping": {"true": "yes", "false": "no"}
          }
        },
        "say_time": {
          "type": "string",
          "_transform": {
            "type": "boolean_to_yes_no",
            "from": "boolean",
            "to": "string",
            "mapping": {"true": "yes", "false": "no"}
          }
        }
      }
    },
    
    "createSubAccount": {
      "parameters": {
        "allowed_codecs": {
          "type": "string",
          "_transform": {
            "type": "list_to_semicolon",
            "from": "array",
            "to": "string",
            "delimiter": ";"
          }
        },
        "username": {
          "type": "string",
          "_type_override_reason": "WSDL incorrectly declares as integer"
        },
        "password": {
          "type": "string",
          "_type_override_reason": "WSDL incorrectly declares as integer"
        }
      }
    },
    
    "getCDR": {
      "_smart_defaults": {
        "timezone": "1"
      },
      "_date_validations": {
        "max_days": 92
      }
    },
    
    "getCallRecordings": {
      "_parameter_aliases": {
        "from_date": "date_from",
        "to_date": "date_to"
      }
    },
    
    "getSMS": {
      "_parameter_aliases": {
        "date_from": "from",
        "date_to": "to"
      }
    },
    
    "setQueue": {
      "parameters": {
        "join_when_empty": {
          "type": "string",
          "_transform": {
            "type": "boolean_to_yes_no",
            "from": "boolean",
            "to": "string",
            "mapping": {"true": "yes", "false": "no"}
          }
        },
        "leave_when_empty": {
          "type": "string",
          "_transform": {
            "type": "boolean_to_yes_no",
            "from": "boolean",
            "to": "string",
            "mapping": {"true": "yes", "false": "no"}
          }
        },
        "ring_inuse": {
          "type": "string",
          "_transform": {
            "type": "boolean_to_yes_no",
            "from": "boolean",
            "to": "string",
            "mapping": {"true": "yes", "false": "no"}
          }
        },
        "join_announcement": {
          "_transform": {
            "type": "special_value_mapping",
            "mapping": {
              "__none__": "none"
            }
          }
        },
        "maximum_wait_time": {
          "_transform": {
            "type": "special_value_mapping",
            "mapping": {
              "__none__": "unlimited",
              "-1": "unlimited"
            }
          }
        },
        "maximum_callers": {
          "_transform": {
            "type": "special_value_mapping",
            "mapping": {
              "__none__": "unlimited",
              "-1": "unlimited"
            }
          }
        }
      }
    },
    
    "getClients": {
      "parameters": {
        "client": {
          "type": "string",
          "_type_override_reason": "Accepts email addresses like 'john.doe@mydomain.com'"
        }
      }
    },
    
    "getDIDsInfo": {
      "parameters": {
        "client": {
          "type": "string",
          "_type_override_reason": "Accepts values like '100001_VoIP'"
        }
      }
    },
    
    "sendVoicemailEmail": {
      "parameters": {
        "email_address": {
          "type": "string",
          "_type_override_reason": "Accepts email addresses"
        }
      }
    }
  }
}