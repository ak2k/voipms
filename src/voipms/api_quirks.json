{
  "version": "1.0",
  "error_code_additions": {
    "invalid_if_announce_position_enabled_report_estimated_hold_time": {
      "code": "invalid_if_announce_position_enabled_report_estimated_hold_time",
      "message": "This is not a Report estimated hold time type",
      "source": "voipms_response_analysis",
      "note": "Queue-related error not found in official HTML documentation"
    },
    "missing_if_announce_position_enabled_report_estimated_hold_time": {
      "code": "missing_if_announce_position_enabled_report_estimated_hold_time",
      "message": "If announce position enabled report estimated hold time type was not provided",
      "source": "voipms_response_analysis",
      "note": "Queue-related error not found in official HTML documentation"
    }
  },
  "quirks": {
    "getCDR": {
      "defaults": {
        "timezone": "1"
      },
      "date_validations": {
        "max_days": 92
      }
    },
    "getCallRecordings": {
      "aliases": {
        "from_date": "date_from",
        "to_date": "date_to"
      }
    },
    "getSMS": {
      "aliases": {
        "date_from": "from",
        "date_to": "to"
      }
    },
    "getMMS": {
      "aliases": {
        "date_from": "from",
        "date_to": "to"
      }
    },
    "setCallerIDFiltering": {
      "aliases": {
        "filter_id": "filter"
      }
    },
    "createSubAccount": {
      "list_to_semicolon": [
        "allowed_codecs"
      ]
    },
    "setVoicemail": {
      "yes_no_strings": [
        "attach_message",
        "delete_message",
        "say_time",
        "say_callerid"
      ]
    },
    "setClient": {
      "aliases": {
        "zip_code": "zip"
      }
    },
    "setQueue": {
      "yes_no_strings": [
        "join_when_empty",
        "leave_when_empty",
        "ring_inuse"
      ],
      "special_values": {
        "join_announcement": {
          "__none__": "none"
        },
        "maximum_wait_time": {
          "__none__": "unlimited",
          "-1": "unlimited"
        },
        "maximum_callers": {
          "__none__": "unlimited",
          "-1": "unlimited"
        }
      }
    },
    "setConferenceMember": {
      "yes_no_strings": [
        "admin",
        "start_muted",
        "announce_user_count"
      ]
    },
    "setRingGroup": {
      "list_to_semicolon": [
        "members"
      ]
    },
    "setTimeCondition": {
      "list_to_semicolon": [
        "routing_match",
        "routing_nomatch"
      ]
    }
  }
}